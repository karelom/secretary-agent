# Pi CLI settings. Omit provider/model to use Pi's configured default.
PI_BIN=pi
PI_PROVIDER=
PI_MODEL=

# LM Studio model availability check (defaults to http://127.0.0.1:1234).
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
LM_STUDIO_API_TOKEN=

# Task Manager API; use the same random token in both local apps.
TASK_MANAGER_API_URL=http://127.0.0.1:3000/api/assistant/tasks
TASK_MANAGER_API_TOKEN=
